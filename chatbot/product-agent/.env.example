APP_NAME="Cosmetics Product Agent"
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=models/gemini-embedding-2
LLM_TIMEOUT=60.0

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=beautyshop
## Optional image-search MVP; local paths default under data/ and ../../backend/uploads
IMAGE_SEARCH_ENABLED=false
IMAGE_SEARCH_INTERNAL_TOKEN=
IMAGE_SEARCH_MODEL_ID=sentence-transformers/clip-ViT-B-32
IMAGE_SEARCH_MODEL_REVISION=327ab6726d33c0e22f920c83f2ff9e4bd38ca37f
IMAGE_SEARCH_MAX_BYTES=5242880
IMAGE_SEARCH_MAX_PIXELS=20000000
IMAGE_SEARCH_BATCH_SIZE=16
IMAGE_SEARCH_MEDIA_ORIGIN=http://localhost:8080
IMAGE_SEARCH_ALLOWED_ORIGINS=
IMAGE_SEARCH_EXCLUDED_HOSTS=images.unsplash.com,via.placeholder.com,placehold.co
