SERVER_PORT=8080
CHATBOT_PORT=18000

DB_URL=jdbc:mysql://localhost:3306/beautyshop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

HIKARI_MAX_POOL_SIZE=15
HIKARI_MIN_IDLE=5

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DIALECT=org.hibernate.dialect.MySQLDialect
FLYWAY_ENABLED=true
CACHE_PROVIDER=redis

# Docker Compose enables the worker. For a standalone backend, set true
# and set REVIEW_SENTIMENT_URL to the internal URL reachable by that process.
REVIEW_SENTIMENT_ENABLED=true

# Generate a unique key, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=beautyshop-group

SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key_here
SEPAY_BANK_NAME=MBBank
SEPAY_BANK_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME
SEPAY_BANK_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_BIN=970422

# Email Transport (Optional - Cấu hình gửi email thực tế qua Gmail SMTP)
MAIL_ENABLED=false
MAIL_SUPPORT_EMAIL=
MAIL_SUPPORT_PHONE=
# Public HTTP(S) server origin for product images in emails
MAIL_MEDIA_BASE_URL=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-google-app-password
MAIL_FROM=no-reply@beautyshop.vn
SPA_REMINDER_HOURS=24
SPA_FINAL_REMINDER_HOURS=2
SPA_NOTIFICATION_POLL_INTERVAL_MS=60000
CUSTOMER_APP_URL=https://www.dermascan.world

# Data Retention (Dọn dẹp bản ghi Outbox và RefreshTokenSession cũ)
RETENTION_DAYS=14
RETENTION_CRON=0 0 3 * * SUN
## Optional image-search MVP (same token on Java and Python; never expose to frontend)
IMAGE_SEARCH_ENABLED=false
CHATBOT_LEGACY_IMAGE_SEARCH_ENABLED=false
IMAGE_SEARCH_INTERNAL_TOKEN=
IMAGE_SEARCH_MODEL_ID=sentence-transformers/clip-ViT-B-32
IMAGE_SEARCH_MODEL_REVISION=327ab6726d33c0e22f920c83f2ff9e4bd38ca37f
IMAGE_SEARCH_MEMORY_LIMIT=1100m
IMAGE_SEARCH_REINDEX_BATCH_SIZE=2
IMAGE_SEARCH_ALLOWED_ORIGINS=
IMAGE_SEARCH_TIMEOUT_SECONDS=30

# Required for the Grafana service in Docker Compose
GRAFANA_ADMIN_PASSWORD=

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://dermascan.world,https://www.dermascan.world,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost

# Chatbot Internal Token & CORS Origins
CHATBOT_INTERNAL_TOKEN=
CHATBOT_CORS_ALLOWED_ORIGINS=
# Google Sign-In for the customer web. Use the public Web OAuth Client ID.
GOOGLE_OAUTH_CLIENT_ID=

# Shipper app
SHIPPER_EARNING_PER_DELIVERY=

SHIPPER_ANDROID_KEYSTORE=

SHIPPER_ANDROID_STORE_PASSWORD=

SHIPPER_ANDROID_KEY_ALIAS=

SHIPPER_ANDROID_KEY_PASSWORD=

# Endpoints for services running outside Docker Compose.
REDIS_HOST=localhost
CHATBOT_SERVICE_URL=http://localhost:8000
CHATBOT_RECOMMENDATION_FALLBACK_URL=http://localhost:18000
IMAGE_SEARCH_SERVICE_URL=http://localhost:8001
REVIEW_SENTIMENT_URL=http://localhost:8002
# Internal service addresses used by Docker Compose.
COMPOSE_DB_URL=jdbc:mysql://mysql:3306/beautyshop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
COMPOSE_REDIS_HOST=redis
COMPOSE_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
COMPOSE_CHATBOT_SERVICE_URL=http://chatbot:8000
COMPOSE_IMAGE_SEARCH_SERVICE_URL=http://image-search:8001
COMPOSE_REVIEW_SENTIMENT_URL=http://review-sentiment:8002
COMPOSE_IMAGE_SEARCH_MEDIA_ORIGIN=http://backend:8080
COMPOSE_CHATBOT_SESSION_REDIS_URL=redis://redis:6379/2

# Public browser API URL. Leave blank when using the bundled reverse proxy.
VITE_API_BASE_URL=
