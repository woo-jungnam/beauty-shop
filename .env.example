SERVER_PORT=8080
CHATBOT_PORT=18000

DB_URL=jdbc:mysql://localhost:3306/beautyshop?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

HIKARI_MAX_POOL_SIZE=15
HIKARI_MIN_IDLE=5

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DIALECT=org.hibernate.dialect.MySQLDialect
FLYWAY_ENABLED=true
CACHE_PROVIDER=redis

# Generate a unique key, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=beautyshop-group

SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key_here
SEPAY_BANK_NAME=MBBank
SEPAY_BANK_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME
SEPAY_BANK_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_BIN=970422

# Email Transport (Optional - Cấu hình gửi email thực tế qua Gmail SMTP)
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-google-app-password
MAIL_FROM=no-reply@beautyshop.vn

# Data Retention (Dọn dẹp bản ghi Outbox và RefreshTokenSession cũ)
RETENTION_DAYS=14
RETENTION_CRON=0 0 3 * * SUN
